@model SafeBarrio.Web.Entities.ContactoEmergencia

@{
    ViewBag.Title = "Agregar Contacto";
}

<div class="safe-card mx-auto" style="max-width:700px;">
    <h2 class="text-center mb-4">Agregar Contacto de Emergencia</h2>

    @using (Html.BeginForm("Crear", "ContactosEmergencia", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <label>Nombre</label>
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control mb-3", placeholder = "Nombre del contacto" })

        <label>Teléfono</label>
        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control mb-3", placeholder = "Número de teléfono" })

        <label>Parentesco</label>
        @Html.TextBoxFor(m => m.Parentesco, new { @class = "form-control mb-4", placeholder = "Ejemplo: Madre, hermano, amigo" })

        <button type="submit" class="btn btn-safe w-100">Guardar Contacto</button>
    }

    <div class="text-center mt-3">
        @Html.ActionLink("Volver", "Index")
    </div>
</div>