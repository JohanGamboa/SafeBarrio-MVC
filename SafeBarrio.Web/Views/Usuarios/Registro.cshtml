@model SafeBarrio.Web.Entities.Usuario

@{
    ViewBag.Title = "Crear Cuenta";
}

<div class="safe-card mx-auto" style="max-width:650px;">
    <h2 class="text-center mb-4">Crear Cuenta</h2>

    @using (Html.BeginForm("Registro", "Usuarios", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control mb-3", placeholder = "Nombre" })
        @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control mb-3", placeholder = "Apellido" })
        @Html.TextBoxFor(m => m.Correo, new { @class = "form-control mb-3", type = "email", placeholder = "Correo electrónico" })
<input type="password"
       name="password"
       class="form-control mb-3"
       placeholder="Contraseña" />
        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control mb-3", placeholder = "Teléfono" })
        @Html.TextBoxFor(m => m.Ubicacion, new { @class = "form-control mb-4", placeholder = "Dirección o sector" })

        <button type="submit" class="btn btn-safe w-100">Registrarse</button>
    }

    <div class="text-center mt-3">
        @Html.ActionLink("Ya tengo cuenta", "Login", "Usuarios")
    </div>
</div>