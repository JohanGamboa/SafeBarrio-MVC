@model SafeBarrio.Web.Entities.Usuario

@{
    ViewBag.Title = "Editar Perfil";
}

<div class="safe-card mx-auto" style="max-width:800px;">
    <div class="text-center mb-4">
        <img src="~/Content/Images/logo-safebarrio.png" style="width:160px;" />
        <h2 class="mt-3">Editar Perfil</h2>
    </div>

    @using (Html.BeginForm("EditarPerfil", "Usuarios", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.FechaRegistro)
        @Html.HiddenFor(m => m.PasswordHash)
        @Html.HiddenFor(m => m.EsAdmin)

        <label>Nombre</label>
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control mb-3" })

        <label>Apellido</label>
        @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control mb-3" })

        <label>Correo</label>
        @Html.TextBoxFor(m => m.Correo, new { @class = "form-control mb-3", type = "email" })

        <label>Teléfono</label>
        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control mb-3" })

        <label>Dirección / Sector</label>
        @Html.TextBoxFor(m => m.Ubicacion, new { @class = "form-control mb-4" })

        <button type="submit" class="btn btn-safe w-100">
            Guardar Cambios
        </button>
    }

    <div class="text-center mt-3">
        @Html.ActionLink("Volver al Perfil", "Perfil", "Usuarios")
    </div>
</div>