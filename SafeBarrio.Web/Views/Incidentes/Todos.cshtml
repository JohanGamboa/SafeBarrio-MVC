@model IEnumerable<SafeBarrio.Web.Entities.Incidente>

@{
    ViewBag.Title = "Todos los Incidentes";
}

<div class="safe-card">
    <h2 class="mb-4">Reportes de Incidentes</h2>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow border-0 rounded-4 h-100">
                    <div class="card-body">

                        @if (!string.IsNullOrEmpty(item.ImagenRuta))
                        {
                            <img src="@item.ImagenRuta"
                                 class="img-fluid rounded mb-3"
                                 style="width:100%; height:220px; object-fit:cover;" />
                        }

                        <h5><strong>@item.TipoIncidente</strong></h5>

                        <p>@item.Descripcion</p>

                        <p>
                            <strong>Referencia:</strong>
                            @item.DireccionReferencia
                        </p>

                        <p>
                            <strong>Estado:</strong>
                            @item.Estado
                        </p>

                        <p>
                            <strong>Fecha:</strong>
                            @item.FechaReporte.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p>
                            <strong>Lat:</strong>
                            @item.Latitud
                        </p>

                        <p>
                            <strong>Lng:</strong>
                            @item.Longitud
                        </p>

                    </div>
                </div>
            </div>
        }
    </div>
</div>